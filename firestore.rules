rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function currentUserName() {
      return request.auth.token.phone_number != null
        ? request.auth.token.phone_number
        : request.auth.token.email.split('@')[0];
    }
    function isParticipant(data) {
      return signedIn() && data.participants is list
        && data.participants.hasAny([currentUserName()]);
    }
    function ownsUser(data) {
      return signedIn() && data.uid == request.auth.uid;
    }

    // Private account documents: only the authenticated owner can access them.
    match /users/{userId} {
      allow read: if ownsUser(resource.data);
      allow create: if ownsUser(request.resource.data);
      allow update: if ownsUser(resource.data) && ownsUser(request.resource.data);
      allow delete: if ownsUser(resource.data);
    }

    // Minimal contact-card data only. Phone fields are omitted when discovery is disabled.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'photoUrl', 'online',
          'discoverableByPhone', 'phoneNumber', 'phoneSearch'
        ]);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /privateUsers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data);
      allow update: if isParticipant(resource.data) && isParticipant(request.resource.data);
      allow delete: if isParticipant(resource.data);
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isParticipant(parentChat());
        allow create: if isParticipant(parentChat())
          && request.resource.data.from == currentUserName();
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data)
        && request.resource.data.caller == currentUserName();
      allow update: if isParticipant(resource.data) && isParticipant(request.resource.data);
      allow delete: if false;
      match /candidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read: if isParticipant(parentCall());
        allow create: if isParticipant(parentCall())
          && request.resource.data.from == currentUserName();
        allow update, delete: if false;
      }
    }

    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == currentUserName();
      allow update, delete: if signedIn() && resource.data.owner == currentUserName();
    }

    match /communities/{communityId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if signedIn()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid;
    }
  }
}